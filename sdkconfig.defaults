# ============================================================================
#  Smart Light 默认配置（menuconfig 修改后会写入 sdkconfig，本文件只作为默认值）
# ============================================================================

# ---------- Flash / 分区表 ----------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------- 蓝牙 (BLE 配网) ----------
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
# BLE 配网（wifi_prov_scheme_ble / protocomm BLE）需要 BLE 4.2 广播 API
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_ADV_EN=y
CONFIG_BT_BLE_42_SCAN_EN=y
# BLE 4.2 与 BLE 5.0 不能同时使用
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
# WiFi + BLE 共存
CONFIG_ESP32_WIFI_SW_COEXIST_ENABLE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ---------- OTA ----------
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---------- MQTT / LwIP ----------
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=n
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y

# ---------- 串口控制台 ----------
# 本板子用 ESP32-S3 内置的 USB Serial/JTAG 连电脑
# （设备管理器里 VID_303A&PID_1001，就是那个 COM3）。
#
# 默认配置是 "主 console = UART0(GPIO43/44) + 次要输出 = USB"，
# 那样 USB 口【只能看日志、不能输入命令】，敲任何命令都会
# "Writing to serial is timing out"。
# 想要在同一个 USB 口上既能看日志又能输命令，主 console 必须选 USB Serial/JTAG。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---------- 系统 ----------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---------- PSRAM (N16R8 = 16MB Flash + 8MB Octal PSRAM) ----------
# 必须开：只靠 243KB 内部 SRAM 跑 WiFi + Bluedroid + BT Controller + TLS 会
# 把堆耗尽，表现为 esp_bt_controller_init 阶段内存异常（Guru Meditation）。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
# 允许 malloc 使用 PSRAM；小于 4KB 的块仍优先走内部 SRAM
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# WiFi / LwIP 的大缓冲搬到 PSRAM，把内部 SRAM 留给 BT controller
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 始终保留 64KB 内部 SRAM，避免 BT / DMA 分配不到内部内存
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# ---------- 注意 ----------
# 启用 PSRAM 后 GPIO33~37 被占用，本工程使用的
# 4/6/7/8/9/16/17/18 均不冲突。
# 若换用不带 PSRAM 的模组，把上面整段删掉即可。

# ---------- WiFi 默认凭据（写死进固件，未配网时使用） ----------
# 仅作调试用；正式使用建议留空、改用 BLE 配网。
#
# 留空 = 不带内置 WiFi 凭据，开机自动进入 BLE 配网。
# 若想跳过配网、开机直连固定 WiFi（仅调试用），填下面两行：
#   CONFIG_WIFI_STA_SSID="YourWiFi"
#   CONFIG_WIFI_STA_PASSWORD="YourPassword"
#
CONFIG_WIFI_STA_SSID=""
CONFIG_WIFI_STA_PASSWORD=""

# ---- MQTT 云端：指向局域网内运行 host/broker.js 的机器 ----
# 请把地址改成实际的 Broker 主机 IP（不要用示例地址直接编译运行）。
CONFIG_CLOUD_MQTT_ENABLE=y
CONFIG_CLOUD_MQTT_URI="mqtt://192.168.1.100:1883"
CONFIG_CLOUD_MQTT_USERNAME=""
CONFIG_CLOUD_MQTT_PASSWORD=""
CONFIG_CLOUD_MQTT_DEVICE_ID=""
# CONFIG_CLOUD_MQTT_TB_MODE is not set
CONFIG_CLOUD_MQTT_POST_INTERVAL_SEC=5
